rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Base helper to check if a user is securely logged into Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. User Profiles: strict isolation, can only read/edit their own profile document
    match /User/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // 2. Core Entities: authenticated users have access to Farm structures.
    match /Farm/{farmId} {
      allow read, write: if isAuthenticated();
    }

    match /Zone/{zoneId} {
      allow read, write: if isAuthenticated();
    }

    // 3. Telemetry, Hardware Topology, and Equipment
    match /Sensor/{document=**} {
      allow read, write: if isAuthenticated();
    }
    
    match /SensorReading/{document=**} {
      allow read, write: if isAuthenticated();
    }

    match /Device/{document=**} {
      allow read, write: if isAuthenticated();
    }

    match /HardwareConnection/{document=**} {
      allow read, write: if isAuthenticated();
    }

    match /RelayModule/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // 4. Actuators, Alerts, and Crops
    match /Fan/{document=**} {
      allow read, write: if isAuthenticated();
    }
    
    match /Cooler/{document=**} {
      allow read, write: if isAuthenticated();
    }
    
    match /Alert/{document=**} {
      allow read, write: if isAuthenticated();
    }

    match /CropBatch/{document=**} {
      allow read, write: if isAuthenticated();
    }

    match /CropRecord/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // 5. Farm Data Lifecycle Collections
    match /PlantingRecord/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /SeedRecord/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /CloningRecord/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /TransplantingRecord/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /VegetativeRecord/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /DiscardedRecord/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /PreHarvestRecord/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /PostHarvestRecord/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /StoragePackagingRecord/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /SprayingRecord/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /CultivationRecord/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /HarvestRecord/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /EquipmentEvent/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /EnvironmentalThreshold/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /KnowledgeBase/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /Task/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /Notification/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /MaintenanceLog/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // 6. Catch-all fallback blocking unauthorized deep nested queries
    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
